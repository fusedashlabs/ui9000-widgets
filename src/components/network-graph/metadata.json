{
  "id": "network-graph",
  "tag": "ui9000-network-graph",
  "title": "Network Graph",
  "description": "Chat-optimized FuseDash NetworkGraph rewritten in D3 (d3-force/-drag/-zoom). Nodes fill a dashed circle, sized by value and coloured by group, with a Network / Heatmap toggle, a focus view of a node and its links, and a size legend filter. Topics, a ranking, dates and metrics in the payload add the topic list, the details column and the timeline. No Redux.",
  "chartTypeKeys": [
    "networkGraphChart"
  ],
  "source": "client/libs/shared/components/src/Widgets/NetworkGraph/",
  "stack": "d3",
  "lazyImport": "@ui9000/widgets/lazy/network-graph",
  "entry": "@ui9000/widgets/network-graph",
  "usageConditions": {
    "host": "mcp-chat",
    "notFor": "fusedash-editor",
    "mapsExcluded": true
  },
  "allowedActions": [
    "hover",
    "select",
    "drag",
    "zoom",
    "filter",
    "resize"
  ],
  "tier": "engine",
  "intents": [
    "graph"
  ],
  "dataRoles": [
    {
      "id": "nodes",
      "required": true,
      "description": "Entities in the graph (hosts, users, assets)."
    },
    {
      "id": "links",
      "required": true,
      "description": "Relationships between nodes."
    }
  ],
  "eligibility": [
    {
      "when": "profile.hasNodes && profile.hasLinks",
      "reason": "Network graph shows entities and the edges between them."
    }
  ],
  "disqualify": [
    {
      "when": "!profile.hasNodes || !profile.hasLinks",
      "reason": "Without both nodes and links the graph is empty; use table or entity-detail."
    },
    {
      "when": "profile.hasGeo && !profile.hasNodes",
      "reason": "Spatial-only data belongs on map-chart."
    }
  ],
  "accessibility": {
    "nameFrom": "title",
    "keyboard": [
      "Tab into graph",
      "filter legend",
      "arrow keys, Page Up/Down, Home and End on the timeline",
      "Escape closes the focus view and the topic list"
    ],
    "shadowBoundary": "Do not use aria-labelledby across the host; set aria-label on the host element."
  },
  "evalCases": [
    {
      "id": "network-picks-nodes-links",
      "intent": "graph",
      "profile": {
        "hasNodes": true,
        "hasLinks": true
      },
      "expect": "eligible",
      "reasonIncludes": "edges"
    },
    {
      "id": "network-rejects-missing-links",
      "intent": "graph",
      "profile": {
        "hasNodes": true,
        "hasLinks": false
      },
      "expect": "disqualified",
      "reasonIncludes": "table"
    }
  ],
  "propsSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "data": {
        "oneOf": [
          {
            "type": "object",
            "description": "FuseDash WidgetItem-shaped payload — the graph lives in data[0].",
            "required": [
              "data"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "nodes": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/node"
                      }
                    },
                    "links": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/link"
                      }
                    },
                    "topics": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/topic"
                      },
                      "description": "Entries of the topic list; node types are used when missing."
                    },
                    "ranking": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/rankingEntry"
                      },
                      "description": "Ranking shown when no topic has its own."
                    },
                    "labels": {
                      "$ref": "#/$defs/labels"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "description": "Graph payload from chat.",
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                }
              },
              "links": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/link"
                }
              },
              "topics": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/topic"
                },
                "description": "Entries of the topic list; node types are used when missing."
              },
              "ranking": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/rankingEntry"
                },
                "description": "Ranking shown when no topic has its own."
              },
              "labels": {
                "$ref": "#/$defs/labels"
              }
            }
          },
          {
            "type": "array",
            "description": "Links only — node ids are derived from the endpoints.",
            "items": {
              "$ref": "#/$defs/link"
            }
          }
        ]
      },
      "chart-title": {
        "type": "string"
      },
      "show-header": {
        "type": "boolean",
        "default": true
      },
      "show-legend": {
        "type": "boolean",
        "default": true
      },
      "show-tooltip": {
        "type": "boolean",
        "default": true
      },
      "wheel-zoom": {
        "type": "boolean",
        "default": false,
        "description": "A plain wheel zooms. Off, it needs ctrl/cmd and a plain wheel scrolls the page; keep it off in the chat."
      },
      "message": {
        "type": "string",
        "description": "Shown over the stage, for the host to say why there is no graph."
      }
    },
    "required": [
      "data"
    ],
    "$defs": {
      "node": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": "number",
            "description": "Drives the size bucket."
          },
          "type": {
            "type": "string",
            "description": "Category key → node colour."
          },
          "color": {
            "type": "string"
          },
          "img": {
            "type": "string",
            "description": "Avatar URL clipped to the node circle."
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Topics the node belongs to, besides its type."
          },
          "date": {
            "type": "string",
            "description": "ISO date; the timeline shows the node from this date."
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Left arc of the focus view."
          },
          "role": {
            "type": "string",
            "description": "Line under the name on the node card; the type when missing."
          },
          "metrics": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/metric"
            },
            "description": "Tiles and chart of the node card."
          },
          "bio": {
            "type": "string",
            "description": "Text of the Bio tab."
          },
          "eventsLabel": {
            "type": "string",
            "description": "Title of the left arc; \"Events\" when missing."
          },
          "linksLabel": {
            "type": "string",
            "description": "Title of the right arc and the card list; \"Connections\" when missing."
          }
        }
      },
      "link": {
        "type": "object",
        "required": [
          "source",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "type": {
            "type": "string",
            "enum": [
              "primary",
              "neutral",
              "secondary"
            ]
          },
          "date": {
            "type": "string",
            "description": "ISO date; the timeline shows the link from this date."
          }
        }
      },
      "metric": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "change": {
            "type": "number"
          },
          "changeUnit": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "What the value and its change are."
          },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "date",
                "value"
              ],
              "properties": {
                "date": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "rankingEntry": {
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "change": {
            "type": "number"
          },
          "changeUnit": {
            "type": "string"
          },
          "connections": {
            "type": "number",
            "description": "Counted from the links when missing."
          }
        }
      },
      "topic": {
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "change": {
            "type": "number"
          },
          "changeUnit": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "selected": {
            "type": "boolean",
            "description": "Selected when the widget opens."
          },
          "metrics": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/metric"
            }
          },
          "ranking": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/rankingEntry"
            }
          }
        }
      },
      "labels": {
        "type": "object",
        "description": "Words of the panels for the data drawn; the design's words stay where one is missing.",
        "properties": {
          "linkValue": {
            "type": "string"
          },
          "nodeValue": {
            "type": "string"
          },
          "heatmapTitle": {
            "type": "string"
          },
          "heatmapSubtitle": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "topics": {
            "type": "string"
          },
          "topicChange": {
            "type": "string"
          },
          "ranking": {
            "type": "string"
          },
          "rankingName": {
            "type": "string"
          },
          "rankingValue": {
            "type": "string"
          },
          "rankingChange": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          }
        }
      }
    }
  }
}
