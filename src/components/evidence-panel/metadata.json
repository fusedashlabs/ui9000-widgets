{
  "id": "evidence-panel",
  "tag": "ui9000-evidence-panel",
  "title": "Evidence Panel",
  "description": "Claim + severity + sources. Optionally composes table/text/image.",
  "chartTypeKeys": [],
  "source": "ui9000-widgets Stage 2 close-out",
  "stack": "lit",
  "lazyImport": "@ui9000/widgets/lazy/evidence-panel",
  "entry": "@ui9000/widgets/evidence-panel",
  "usageConditions": {
    "host": "mcp-chat",
    "notFor": "fusedash-editor",
    "mapsExcluded": true
  },
  "allowedActions": [
    "select",
    "resize"
  ],
  "tier": "engine",
  "intents": [
    "evidence"
  ],
  "dataRoles": [
    {
      "id": "claim",
      "required": true,
      "description": "The assertion being evidenced."
    },
    {
      "id": "sources",
      "required": true,
      "description": "Supporting sources with http(s) hrefs."
    }
  ],
  "eligibility": [
    {
      "when": "profile.hasClaim",
      "reason": "Evidence panel states a claim and its sources."
    }
  ],
  "disqualify": [
    {
      "when": "!profile.hasClaim",
      "reason": "Without a claim use table or entity-detail."
    }
  ],
  "accessibility": {
    "nameFrom": "claim",
    "keyboard": [
      "Tab through sources"
    ],
    "shadowBoundary": "Do not use aria-labelledby across the host; set aria-label on the host element."
  },
  "evalCases": [
    {
      "id": "evidence-picks-claim",
      "intent": "evidence",
      "profile": {
        "hasClaim": true
      },
      "expect": "eligible",
      "reasonIncludes": "claim"
    },
    {
      "id": "evidence-rejects-no-claim",
      "intent": "evidence",
      "profile": {
        "hasClaim": false,
        "hasTabularRows": true
      },
      "expect": "disqualified",
      "reasonIncludes": "table"
    }
  ],
  "propsSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "data": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "sources": {
            "type": "array"
          },
          "table": {
            "type": "object"
          },
          "text": {
            "type": "string"
          },
          "image": {
            "type": "object"
          }
        },
        "required": [
          "claim"
        ]
      }
    },
    "required": [
      "data"
    ]
  }
}
