{
  "id": "waterfall-chart",
  "tag": "ui9000-waterfall-chart",
  "title": "Waterfall Chart",
  "description": "Chat-optimized waterfall rewritten in D3. Dual orientation, cumulative levels / delta flags, no Redux.",
  "chartTypeKeys": ["waterfallChart"],
  "source": "client/libs/shared/components/src/Widgets/WaterfallChart/",
  "stack": "d3",
  "lazyImport": "@ui9000/widgets/lazy/waterfall-chart",
  "entry": "@ui9000/widgets/waterfall-chart",
  "usageConditions": {
    "host": "mcp-chat",
    "notFor": "fusedash-editor",
    "mapsExcluded": true
  },
  "allowedActions": ["hover", "resize"],
  "propsSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "data": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "properties": {
                "label": { "type": "string" },
                "value": { "type": "number" },
                "kind": {
                  "type": "string",
                  "enum": ["total", "increase", "decrease"]
                }
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["label", "value"],
                  "properties": {
                    "label": { "type": "string" },
                    "value": { "type": "number" },
                    "kind": {
                      "type": "string",
                      "enum": ["total", "increase", "decrease"]
                    }
                  }
                }
              },
              "orientation": {
                "type": "string",
                "enum": ["horizontal", "vertical"]
              }
            }
          }
        ]
      },
      "orientation": {
        "type": "string",
        "enum": ["horizontal", "vertical"],
        "default": "horizontal"
      },
      "showGrid": { "type": "boolean", "default": true },
      "showLegend": { "type": "boolean", "default": true },
      "showTooltip": { "type": "boolean", "default": true },
      "xLabel": { "type": "string" },
      "yLabel": { "type": "string" }
    },
    "required": ["data"]
  }
}
