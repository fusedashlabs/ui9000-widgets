# Storybook + Vite (playground). Copy to `.env` and restart `yarn storybook`.
# Same public token FuseDash charts uses: client/apps/charts/.env → REACT_APP_MAPBOX_ACCESS_TOKEN
STORYBOOK_MAPBOX_TOKEN=
VITE_MAPBOX_TOKEN=
# Dark style is a different Mapbox account. Terrain still uses the light token.
STORYBOOK_MAPBOX_DARK_TOKEN=
VITE_MAPBOX_DARK_TOKEN=
